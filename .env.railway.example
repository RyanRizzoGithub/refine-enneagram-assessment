# ============================================================
# Environment variables to set in Railway (Project > Variables).
# These REPLACE the old .env. Values marked <FROM BACKUP> come from
# eoa.env.backup; DB_* come from your Supabase connection settings.
# Do NOT commit real secrets — this file is only a checklist.
# ============================================================

APP_NAME=theREFINEnetwork
APP_ENV=production
APP_KEY=<FROM BACKUP: reuse the existing base64: key so sessions/tokens stay valid>
APP_DEBUG=false
APP_URL=<Railway URL for now, e.g. https://xxxx.up.railway.app — swap to the real domain at cutover>

LOG_CHANNEL=stack

# ---------- Supabase Postgres ----------
DB_CONNECTION=pgsql
DB_HOST=<Supabase: db.xxxx.supabase.co  OR the pooler host>
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=<the Supabase database password you saved>

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail was Mailtrap/null in prod (app sends no mail itself) — leave as-is.
MAIL_DRIVER=log

# ---------- ActiveCampaign ----------
ACTIVECAMPAIGN_URL=<FROM BACKUP>
ACTIVECAMPAIGN_KEY=<FROM BACKUP>
ACTIVECAMPAIGN_LIST_ID=9

# ---------- Stripe (LIVE) ----------
STRIPE_LIVE=true
STRIPE_KEY_LIVE=<FROM BACKUP>
STRIPE_SECRET_LIVE=<FROM BACKUP>
STRIPE_WEBHOOK_SECRET_LIVE=
STRIPE_KEY=<FROM BACKUP: test key>
STRIPE_SECRET=<FROM BACKUP: test key>
STRIPE_WEBHOOK_SECRET=
STRIPE_CHARGE_AMOUNT=2400

MIX_APP_NAME=theREFINEnetwork
